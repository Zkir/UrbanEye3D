#: D:\UrbanEye3D\src\main\java\ru\zkir\urbaneye3d\validator\SpatialConsistencyChecks.java:42
msgid "[UrbanEye3D] Building and building parts spatial consistency check"
msgstr "[UrbanEye3D] Проверка пространственной согласованности зданий и их частей"

#: D:\UrbanEye3D\src\main\java\ru\zkir\urbaneye3d\validator\SpatialConsistencyChecks.java:42
msgid "Building outline should be fully covered by parts. Parts should not be orphans. Note this test may show false positives on incomplete data"
msgstr ""
"Контур здания должен быть полностью покрыт его частями. Части не должны лежать вне зданий. Примечание: этот тест может давать ложные срабатывания на неполных данных"

#: D:\UrbanEye3D\src\main\java\ru\zkir\urbaneye3d\validator\SpatialConsistencyChecks.java:240
msgid "Building is not fully covered by its parts"
msgstr "Здание не полностью покрыто своими частями"

#: D:\UrbanEye3D\src\main\java\ru\zkir\urbaneye3d\validator\SpatialConsistencyChecks.java:263
#, java-format
msgid "Building height ({0}m) and calculated part height ({1}m) differ significantly"
msgstr "Высота здания ({0} м) и расчетная высота частей ({1} м) значительно различаются"

#: D:\UrbanEye3D\src\main\java\ru\zkir\urbaneye3d\validator\SpatialConsistencyChecks.java:276
msgid "Orphaned building part"
msgstr "Осиротевшая часть здания"

