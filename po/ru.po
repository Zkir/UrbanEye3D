msgid "Urban Eye 3D"
msgstr "Urban Eye 3D"

#: D:\UrbanEye3D\src\main\java\ru\zkir\urbaneye3d\UrbanEye3dPreferences.java:35
msgid "Enable wireframe rendering mode"
msgstr "Каркасный режим отображения"

#: D:\UrbanEye3D\src\main\java\ru\zkir\urbaneye3d\UrbanEye3dPreferences.java:37
msgid "If checked, buildings will be rendered as outlines instead of solid polygons."
msgstr "Если отмечено, здания будут отображаться в виде каркасов, а не сплошных тел."

#: D:\UrbanEye3D\src\main\java\ru\zkir\urbaneye3d\UrbanEye3dPreferences.java:41
msgid "Enable Ambient Occlusion Mode"
msgstr "Глобальное затенение (имитация)"

#: D:\UrbanEye3D\src\main\java\ru\zkir\urbaneye3d\UrbanEye3dPreferences.java:43
msgid "If checked, a fake ambient occlusion effect will be applied."
msgstr "Если отмечено, будет имитироваться глобальное затенение для придания сцене более реалистичного вида."

#: D:\UrbanEye3D\src\main\java\ru\zkir\urbaneye3d\UrbanEye3dPreferences.java:47
msgid "Automatically download incomplete multipolygons"
msgstr "Автоматически загружать неполные мультиполигоны"

#: D:\UrbanEye3D\src\main\java\ru\zkir\urbaneye3d\UrbanEye3dPreferences.java:49
msgid "If checked, the plugin will attempt to download missing members of multipolygons."
msgstr "Если отмечено, плагин будет пытаться загрузить недостающие части мультиполигонов."

#: D:\UrbanEye3D\src\main\java\ru\zkir\urbaneye3d\UrbanEye3dPreferences.java:100
msgid "Settings for the Urban Eye 3D plugin"
msgstr "Настройки плагина Urban Eye 3D"

#: D:\UrbanEye3D\src\main\java\ru\zkir\urbaneye3d\UrbanEye3dPreferences.java:105
