msgstr "Unvollständige Multipolygone automatisch herunterladen"

#: src/main/java/ru/zkir/urbaneye3d/validator/SpatialConsistencyChecks.java:226
msgid "Building height ({0}m) and calculated part height ({1}m) differ significantly"
msgstr "Gebäudehöhe ({0}m) und berechnete Gebäudeteilehöhe ({1}m) weichen deutlich voneinander ab"

#: src/main/java/ru/zkir/urbaneye3d/validator/SpatialConsistencyChecks.java:213
msgid "Building is not fully covered by its parts"
msgstr "Gebäude wird nicht vollständig von seinen Gebäudeteilen abgedeckt"

#: src/main/java/ru/zkir/urbaneye3d/validator/SpatialConsistencyChecks.java:39
msgid "Building outline should be fully covered by parts. Parts should not be orphans. Note this test may show false positives on incomplete data"
msgstr "Die Gebäudekontur sollte vollständig von Teilen abgedeckt sein. Gebäudeteile sollten nicht verwaist sein. Hinweis: Dieser Test kann bei unvollständigen Daten falsch-positive Ergebnisse anzeigen"

#: src/main/java/ru/zkir/urbaneye3d/validator/TagChecks.java:87
msgid "Building part without height"
msgstr "Gebäudeteil ohne Höhenangabe"

#: src/main/java/ru/zkir/urbaneye3d/validator/TagChecks.java:36
msgid "Checks for tag validity for buildings and building parts."
msgstr "Überprüft die Gültigkeit von Attributen für Gebäude und Gebäudeteile."

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:86
msgid "Configure rendering options for the 3D Viewer."
msgstr "Darstellungsoptionen für den 3D-Betrachter konfigurieren."

msgid "Show scene statistics"
msgstr "Szenenstatistik anzeigen"

msgid "If checked, the number of objects, faces and frame time will be displayed in the top-left corner."
msgstr "Wenn aktiviert, werden die Anzahl der Objekte, Flächen und die Frame-Zeit in der oberen linken Ecke angezeigt."

msgid "Objects: {0}, Faces: {1}, Avg frame time: {2} ms"
msgstr "Objekte: {0}, Flächen: {1}, Durchschn. Frame-Zeit: {2} ms"

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:60
msgid "Forest density"
msgstr "Walddichte"

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:66
msgid "Adjust the number of trees generated in forest polygons. This setting affects performance."
msgstr "Passen Sie die Anzahl der in Waldpolygonen erzeugten Bäume an. Diese Einstellung beeinflusst die Leistung."

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:38
msgid "Enable Ambient Occlusion Mode"
msgstr "Schatteneffekt aktivieren"

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:32
msgid "Enable wireframe rendering mode"
msgstr "Drahtgittermodelldarstellung aktivieren"

#: src/main/java/ru/zkir/urbaneye3d/josmactions/ToggleFakeAOAction.java:15
msgid "Fake AO"
msgstr "Simuliere Schatteneffekt"

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:42
msgid "If checked, a fake ambient occlusion effect will be applied."
msgstr "Wenn aktiviert, wird ein simulierter Schatteneffekt angewendet."

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:36
msgid "If checked, buildings will be rendered as outlines instead of solid polygons."
msgstr "Wenn aktiviert, werden Gebäude als Drahtgittermodell anstelle von ausgefüllten Polygonen dargestellt."

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:48
msgid "If checked, the plugin will attempt to download missing members of multipolygons."
msgstr "Wenn aktiviert, versucht das Plugin, fehlende Mitglieder von Multipolygonen herunterzuladen."

