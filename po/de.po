# New strings for version 2.2
msgid "Use satellite imagery for ground plane"
msgstr "Satellitenbilder für die Bodenoberfläche verwenden"

msgid "If checked, active satellite imagery will be used in 3D ground plane when available. If unchecked, plugin's own 2D style will be used to render flat objects."
msgstr "Wenn aktiviert, werden aktive Satellitenbilder für die 3D-Bodenoberfläche verwendet (sofern verfügbar). Wenn deaktiviert, wird der eigene 2D-Stil des Plugins verwendet."

msgid "Satellite imagery"
msgstr "Satellitenbilder"

msgid "Toggle satellite imagery on ground plane"
msgstr "Satellitenbilder auf der Bodenoberfläche umschalten"

msgid "Toggle Satellite Imagery"
msgstr "Satellitenbilder umschalten"

msgid "[UrbanEye3D] Overlapping 3D walls check"
msgstr "[UrbanEye3D] Prüfung auf überlappende 3D-Wände"

msgid "Detects overlapping 3D walls that cause Z-fighting."
msgstr "Erkennt überlappende 3D-Wände, die Z-Fighting (Flackern) verursachen."

msgid "Overlapping 3D walls (potential Z-fighting)"
msgstr "Überlappende 3D-Wände (potenzielles Z-Fighting)"

