#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:44
msgid "Automatically download incomplete multipolygons"
msgstr "Unduh multipoligon yang tidak lengkap secara otomatis"

#: src/main/java/ru/zkir/urbaneye3d/validator/SpatialConsistencyChecks.java:226
msgid "Building height ({0}m) and calculated part height ({1}m) differ significantly"
msgstr "Tinggi bangunan ({0}m) dan kalkulasi tinggi bagian bangunan ({1}m) berbeda secara signifikan"

#: src/main/java/ru/zkir/urbaneye3d/validator/SpatialConsistencyChecks.java:213
msgid "Building is not fully covered by its parts"
msgstr "Bangunan tidak tertutup sepenuhnya oleh bagian-bagiannya (building parts)"

#: src/main/java/ru/zkir/urbaneye3d/validator/SpatialConsistencyChecks.java:39
msgid "Building outline should be fully covered by parts. Parts should not be orphans. Note this test may show false positives on incomplete data"
msgstr "Garis luar bangunan harus tertutup sepenuhnya oleh bagian-bagiannya. Bagian bangunan tidak boleh berdiri sendiri (orphan). Catatan: tes ini mungkin menunjukkan hasil positif palsu pada data yang tidak lengkap"

#: src/main/java/ru/zkir/urbaneye3d/validator/TagChecks.java:87
msgid "Building part without height"
msgstr "Bagian bangunan (building part) tanpa tag tinggi (height)"

#: src/main/java/ru/zkir/urbaneye3d/validator/TagChecks.java:36
msgid "Checks for tag validity for buildings and building parts."
msgstr "Memeriksa validitas tag untuk bangunan dan bagian-bagian bangunan."

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:86
msgid "Configure rendering options for the 3D Viewer."
msgstr "Atur opsi render untuk Penampil 3D."

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:38
msgid "Enable Ambient Occlusion Mode"
msgstr "Aktifkan Mode Ambient Occlusion"

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:32
msgid "Enable wireframe rendering mode"
msgstr "Aktifkan mode render wireframe"

#: src/main/java/ru/zkir/urbaneye3d/josmactions/ToggleFakeAOAction.java:15
msgid "Fake AO"
msgstr "AO Buatan"

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:42
msgid "If checked, a fake ambient occlusion effect will be applied."
msgstr "Jika dicentang, efek ambient occlusion buatan akan diterapkan."

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:36
msgid "If checked, buildings will be rendered as outlines instead of solid polygons."
msgstr "Jika dicentang, bangunan akan dirender sebagai garis-garis, bukan poligon."

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:48
msgid "If checked, the plugin will attempt to download missing members of multipolygons."
msgstr "Jika dicentang, plugin akan mencoba mengunduh anggota multipoligon yang hilang."

