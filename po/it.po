msgstr "Scarica automaticamente multipoligoni incompleti"

#: src/main/java/ru/zkir/urbaneye3d/validator/SpatialConsistencyChecks.java:226
msgid "Building height ({0}m) and calculated part height ({1}m) differ significantly"
msgstr "L'altezza dell'edificio ({0}m) e l'altezza della parte calcolata ({1}m) differiscono in modo significativo"

#: src/main/java/ru/zkir/urbaneye3d/validator/SpatialConsistencyChecks.java:213
msgid "Building is not fully covered by its parts"
msgstr "L'edificio non è completamente coperto dalle sue parti"

#: src/main/java/ru/zkir/urbaneye3d/validator/SpatialConsistencyChecks.java:39
msgid "Building outline should be fully covered by parts. Parts should not be orphans. Note this test may show false positives on incomplete data"
msgstr "Il contorno dell'edificio dovrebbe essere completamente coperto da parti. Le parti non dovrebbero essere orfane. Nota che questo test potrebbe mostrare falsi positivi su dati incompleti"

#: src/main/java/ru/zkir/urbaneye3d/validator/TagChecks.java:87
msgid "Building part without height"
msgstr "Parte dell'edificio senza altezza"

#: src/main/java/ru/zkir/urbaneye3d/validator/TagChecks.java:36
msgid "Checks for tag validity for buildings and building parts."
msgstr "Controlli per la validità dei tag per edifici e parti di edifici."

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:86
msgid "Configure rendering options for the 3D Viewer."
msgstr "Configura le opzioni di rendering per il visualizzatore 3D."

msgid "Show scene statistics"
msgstr "Mostra statistiche della scena"

msgid "If checked, the number of objects, faces and frame time will be displayed in the top-left corner."
msgstr "Se selezionato, il numero di oggetti, facce e il tempo di frame verranno visualizzati nell'angolo in alto a sinistra."

msgid "Objects: {0}, Faces: {1}, Avg frame time: {2} ms"
msgstr "Oggetti: {0}, Facce: {1}, Tempo medio frame: {2} ms"

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:60
msgid "Forest density"
msgstr "Densità del bosco"

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:66
msgid "Adjust the number of trees generated in forest polygons. This setting affects performance."
msgstr "Regola il numero di alberi generati nei poligoni forestali. Questa impostazione influisce sulle prestazioni."

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:38
msgid "Enable Ambient Occlusion Mode"
msgstr "Abilita la modalità Ambient Occlusion"

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:32
