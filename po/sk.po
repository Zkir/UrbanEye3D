msgstr "Zapnúť vykresľovanie pomocou drôtového model"

#: src/main/java/ru/zkir/urbaneye3d/josmactions/ToggleFakeAOAction.java:15
msgid "Fake AO"
msgstr "Zdanlivé tienenie"

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:42
msgid "If checked, a fake ambient occlusion effect will be applied."
msgstr "Ak je zapnuté, bude použitý zdanlivý efekt tienenia okolím."

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:36
msgid ""
"If checked, buildings will be rendered as outlines instead of solid polygons."
msgstr ""
"Ak je zapnuté, budovy budú vykreslené len ako obrysy namiesto plných plôch."

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:48
msgid ""
"If checked, the plugin will attempt to download missing members of "
"multipolygons."
msgstr ""
"Ak je zapnuté, plugin sa pokúsi stiahnuť chýbajúce členy multipolygónov."

