#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:84
msgid "Adjust the number of trees generated in forest polygons. This setting affects performance."
msgstr "Ajusta el número de árboles generados en los polígonos de bosque. Este ajuste afecta al rendimiento."

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:85
msgid "Anti-aliasing (MSAA) samples"
msgstr "Muestras de suavizado (MSAA)"

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:59
msgid "Automatically download incomplete multipolygons"
msgstr "Descargar automáticamente los multipolígonos incompletos"

#: src/main/java/ru/zkir/urbaneye3d/validator/SpatialConsistencyChecks.java:221
msgid "Building height ({0}m) and calculated part height ({1}m) differ significantly"
msgstr "La altura del edificio ({0} m) y la altura calculada de sus partes ({1} m) difieren notablemente"

#: src/main/java/ru/zkir/urbaneye3d/validator/SpatialConsistencyChecks.java:200
msgid "Building is not fully covered by its parts"
msgstr "El edificio no está totalmente cubierto por sus partes"

#: src/main/java/ru/zkir/urbaneye3d/validator/SpatialConsistencyChecks.java:45
msgid "Building outline should be fully covered by parts. Parts should not be orphans. Note this test may show false positives on incomplete data"
msgstr "El contorno del edificio debe estar totalmente cubierto por sus partes. Las partes no deben quedar huérfanas. Nota: esta prueba puede dar falsos positivos con datos incompletos"

#: src/main/java/ru/zkir/urbaneye3d/validator/TagChecks.java:137
msgid "Building part without height"
msgstr "Parte de edificio sin altura"

#: src/main/java/ru/zkir/urbaneye3d/validator/TagChecks.java:41
msgid "Checks for tag validity for buildings and building parts."
msgstr "Comprueba la validez de las etiquetas de los edificios y las partes de edificios."

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:162
msgid "Configure rendering options for the 3D Viewer."
msgstr "Configurar las opciones de renderizado del visor 3D."

#: src/main/java/ru/zkir/urbaneye3d/validator/OverlappingWallsCheck.java:26
msgid "Detects overlapping 3D walls that cause Z-fighting."
msgstr "Detecta paredes 3D superpuestas que provocan Z-fighting."

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:53
msgid "Enable Ambient Occlusion Mode"
msgstr "Activar el modo de oclusión ambiental"

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:48
msgid "Enable wireframe rendering mode"
msgstr "Activar el modo de renderizado alámbrico"

#: src/main/java/ru/zkir/urbaneye3d/josmactions/ToggleFakeAOAction.java:15
msgid "Fake AO"
msgstr "AO simulada"

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:77
msgid "Forest density"
msgstr "Densidad de los bosques"

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:58
msgid "If checked, a fake ambient occlusion effect will be applied."
msgstr "Si se marca, se aplicará un efecto de oclusión ambiental simulada."

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:76
msgid "If checked, active satellite imagery will be used in 3D ground plane when available. If unchecked, plugin's own 2D style will be used to render flat objects."
msgstr "Si se marca, se usarán las imágenes de satélite activas en el plano del suelo 3D cuando estén disponibles. Si no se marca, se usará el estilo 2D propio del complemento para renderizar los objetos planos."

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:52
msgid "If checked, buildings will be rendered as outlines instead of solid polygons."
msgstr "Si se marca, los edificios se renderizarán como contornos en lugar de polígonos sólidos."

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:70
msgid "If checked, the number of objects, faces and frame time will be displayed in the top-left corner."
msgstr "Si se marca, se mostrarán el número de objetos, el número de caras y el tiempo por fotograma en la esquina superior izquierda."

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:64
msgid "If checked, the plugin will attempt to download missing members of multipolygons."
msgstr "Si se marca, el complemento intentará descargar los miembros que falten en los multipolígonos."

#: src/main/java/ru/zkir/urbaneye3d/validator/TagChecks.java:118
msgid "Invalid value for roof:direction: {0}"
msgstr "Valor no válido para roof:direction: {0}"

#: src/main/java/ru/zkir/urbaneye3d/validator/TagChecks.java:128
msgid "Invalid value for roof:orientation: {0}"
msgstr "Valor no válido para roof:orientation: {0}"

#: src/main/java/ru/zkir/urbaneye3d/validator/TagChecks.java:108
msgid "Missing tag: roof:shape={0} without ''roof:direction''"
msgstr "Falta una etiqueta: roof:shape={0} sin ''roof:direction''"

#: src/main/java/ru/zkir/urbaneye3d/UrbanEye3dPreferences.java:101
msgid "Number of MSAA samples for smoother edges. 0 means disabled. Higher values improve quality but may reduce performance. Changes require JOSM restart."
msgstr "Número de muestras MSAA para suavizar los bordes. 0 significa desactivado. Los valores más altos mejoran la calidad, pero pueden reducir el rendimiento. Los cambios requieren reiniciar JOSM."

#: src/main/java/ru/zkir/urbaneye3d/Renderer3D.java:493
msgid "Objects: {0}, Faces: {1}, Avg frame time: {2} ms"
msgstr "Objetos: {0}, caras: {1}, tiempo medio por fotograma: {2} ms"

