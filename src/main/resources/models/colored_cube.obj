# Test OBJ file for a colored cube
# 8 vertices, 6 faces, 3 materials

mtllib colored_cube.mtl

v 1.0 1.0 -1.0
v 1.0 -1.0 -1.0
v 1.0 1.0 1.0
v 1.0 -1.0 1.0
v -1.0 1.0 -1.0
v -1.0 -1.0 -1.0
v -1.0 1.0 1.0
v -1.0 -1.0 1.0

usemtl Red
f 1 3 4 2
f 5 7 3 1

usemtl Green
f 6 8 7 5
f 2 4 8 6

usemtl Blue
f 3 7 8 4
f 1 5 6 2
