/*
* Hide undeground and indor objects
*/

node[location=underground],
node[indoor=yes] {
    display: false;
}


/*
* Various object types
*/

/* Trees */
node[natural=tree][leaf_type=broadleaved] {
    billboard: "/textures/trees/tree_000.png";
}

node[natural=tree][leaf_type=needleleaved] {
    billboard: "/textures/trees/tree_001.png";
}

node[natural=tree][leaf_type=palm] {
    billboard: "/textures/trees/tree_002.png";
}

/* Bushes */
node[natural=shrub]{
    billboard: "/textures/bushes/rose_bush.png";
    height: 1.5;
    width: 1.5;
}

/* Bench */
node[amenity=bench],
node[amenity=bench][backrest=no] {
    model: "/models/bench.obj";
    rotatable: true;
}

/* Bench */
node[amenity=bench][backrest=yes] {
    model: "/models/bench_002.obj";
    rotatable: true;
}

/* Street Lamp */
node[highway=street_lamp],
node[highway=street_lamp][lamp_mount=straight_mast] {
    model: "/models/street_lamp.obj";
}

node[highway=street_lamp][lamp_mount=bent_mast] {
    model: "/models/street_lamp_bent.obj";
	snap_to_roads: true;
    rotatable: true;
}

/* Bus Stops */
/* Just a bus stop sign, no shelter*/
node[public_transport=platform],
node[highway=bus_stop],
node[public_transport=platform][shelter=no],
node[highway=bus_stop][shelter=no] {
    model: "/models/bus_stop_sign.obj";
    snap_to_roads: true;
}

/* bus stop with shelter and bench*/
node[public_transport=platform][shelter=yes],
node[highway=bus_stop][shelter=yes],
node[public_transport=platform][shelter=yes][bench=yes],
node[highway=bus_stop][shelter=yes][bench=yes] {
    model: "/models/bus_stop_001.obj";
    snap_to_roads: true;
}

/* bus stop with shelter but without bench*/
node[public_transport=platform][shelter=yes][bench=no],
node[highway=bus_stop][shelter=yes][bench=no] {
    model: "/models/bus_stop_002.obj";
    snap_to_roads: true;
}

/* Tourism Information */
node[tourism=information] {
    model: "/models/info_board.obj";
    rotatable: true;
}

node[tourism=information][information=board] {
    model: "/models/info_board.obj";
    rotatable: true;
}

node[tourism=information][information=post] {
    model: "/models/info_post.obj";
    rotatable: true;
}

node[tourism=information][information=guidepost] {
    model: "/models/guidepost.obj";
	rotatable: false;
}


/* Advertising Column */
node[advertising=column] {
    procedure: "ad_column";
}

/* Busket */
node[amenity=waste_basket] {
    model: "/models/basket.obj";
    rotatable: true;
}

/* Fire Hydrant */
node[emergency=fire_hydrant],
node[emergency=fire_hydrant][fire_hydrant:type=pillar] {
    model: "/models/fire_hydrant.obj";
}

node[emergency=fire_hydrant][fire_hydrant:type=underground] {
    display: false;
}

/* Power */
node[power=tower],
node[power=tower][structure=lattice] {
    model: "/models/power_tower.obj";
}

node[power=tower][structure=solid],
node[power=tower][structure=tubular] {
    model: "/models/power_tower_solid.obj";
}



node[power=pole] {
    model: "/models/power_pole.obj";
}

/* Drinking Water */
node[amenity=drinking_water][natural!=spring] {
    model: "/models/water_column.obj";
	rotatable: true;
}

/* Water Well */
node[man_made=water_well],
node[man_made=water_well][pump=no] {
    model: "/models/water_well.obj";
    rotatable: true;
}

node[man_made=water_well][pump][pump!=no] {
    model: "/models/water_column.obj";
    rotatable: true;
}

/* Barriers */
node[barrier=block] {
    model: "/models/barrier_block.obj";
    rotatable: true;
    snap_to_roads: true;
}

node[barrier=bollard] {
    model: "/models/barrier_bollard.obj";
}

node[barrier=gate] {
    model: "/models/barrier_gate.obj";
    orientation: align_with_parent;
}

node[barrier=lift_gate] {
    model: "/models/barrier_lift_gate.obj";
    orientation: align_with_parent;
	rotatable: true;
}

/* Recycling Container */
node[amenity=recycling][recycling_type=container] {
    model: "/models/recycling_container.obj";
    rotatable: true;
}

node[amenity=recycling][recycling_type!=centre] {
    model: "/models/recycling_container.obj";
    rotatable: true;
}

node[amenity=waste_disposal]
{
    model: "/models/recycling_container.obj";
    rotatable: true;
}

/* Bicycle Parking */
node[amenity=bicycle_parking],
node[amenity=bicycle_parking][bicycle_parking=stands] {
    model: "/models/bicycle_parking.obj";
    rotatable: true;
}

/* Picnic Table */
node[leisure=picnic_table] {
    model: "/models/picnic_table.obj";
    rotatable: true;
}

/* Traffic Calming */
node[traffic_calming=bump] {
    model: "/models/traffic_bump.obj";
    orientation: align_with_parent;
}

node[traffic_calming=hump],
node[traffic_calming=table] {
    model: "/models/traffic_hump.obj";
    orientation: align_with_parent;
}

/* Memorial */
node[historic=memorial][!memorial],
node[historic=memorial][memorial=bust],
node[historic=memorial][memorial=statue] {
    model: "/models/memorial_bust.obj";
    rotatable: true;
    scalable: true;
}

node[historic=memorial][memorial=stone] {
    model: "/models/memorial_stone.obj";
    rotatable: true;
    scalable: true;
}

node[historic=memorial][memorial=stele] {
    model: "/models/memorial_stele.obj";
    rotatable: true;
    scalable: true;
}

node[historic=memorial][memorial=stele][shape=star] {
    model: "/models/memorial_stele_star.obj";
    rotatable: true;
    scalable: true;
}

node[historic=memorial][memorial=obelisk],
node[historic=memorial][memorial=war_memorial] {
    model: "/models/memorial_obelisk.obj";
    rotatable: true;
    scalable: true;
}

node[historic=memorial][memorial=stolperstein] {
    model: "/models/memorial_stolperstein.obj";
    rotatable: true;
}

/* Artwork */
node[tourism=artwork][artwork_type=statue], 
node[tourism=artwork][artwork_type=sculpture],
node[tourism=artwork][artwork_type=installation] {
    model: "/models/sculpture_abstract_spiral.obj";
    rotatable: true;
    scalable: true;
}

/* Railway */
node[railway=buffer_stop] {
    model: "/models/railway_buffer_stop.obj";
    orientation: align_with_parent;
}

/* Wayside Crosses */
node[historic=wayside_cross],
node[man_made=cross] {
    model: "/models/wayside_cross_latin.obj";
    rotatable: true;
    scalable: true;
	snap_to_roads: true;
}

node[historic=wayside_cross][denomination=orthodox],
node[man_made=cross][denomination=orthodox] {
    model: "/models/wayside_cross_orthodox.obj";
    rotatable: true;
    scalable: true;
	snap_to_roads: true;
}




