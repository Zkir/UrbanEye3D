area|z14-[highway=unclassified]:closed,
area|z14-[highway=service]:closed {
    fill-color: white;
}

area|z14-[highway=pedestrian][!tunnel]:closed,
area|z14-[highway=footway][!tunnel]:closed,
area|z14-[highway=path][!tunnel]:closed {
    fill-color: #ededed;
}

area|z14-[highway=track]:closed {
    fill-color: #dfcc66;
}

