    fill-color: #aaaaaa;
    fill-opacity: 0.9;
    color: #111111;
    width: 0.3;
}

/**
 * Layer 'buildings'
 * Style 'buildings'
 * Note: we do not need any classificaiton of buildings
 * Rather we would like to disply buildings in natural colours
 */
  

area|z12-[building][location!=underground]{
	fill-color: any(tag("roof:colour"), "#bca9a9");
    fill-opacity: 0.9;
    z-index: 900;
	
}


