/**
 * Layer 'buildings-lz'
 * Style 'buildings-lz'
 */

area|z10-[railway=station][!building]{
    fill-color: #d4aaaa;
}


area|z10-14[amenity=place_of_worship][!building] {
    fill-color: #777777;
    fill-opacity: 0.5;
}

