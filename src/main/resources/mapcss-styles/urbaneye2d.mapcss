/**
 * Layer 'misc_boundaries'
 * Style 'boundary'
 */

area|z7-9[boundary=national_park] {
    fill-color: green;
    fill-opacity: 0.05;
    color: green;
    dashes: 4,2;
    opacity: 0.15;
    width: 1.5;
}

area|z10-12[boundary=national_park] {
