/*
 * Realistic Roads Style for UrbanEye3D
 *
 * Author: Zkir
 * Version: 1.0
 *
 * This style renders roads with an asphalt appearance, white edge lines,
 * and centerlines appropriate for one-way or two-way traffic.
 */

meta {
    title: "Realistic Roads (Asphalt)";
    version: "1.0";
    description: "Styles roads with asphalt color, edge lines, and centerlines.";
}

canvas {
    /*fill-color: #f1eee8; */
    default-lines: false;
    default-points: false;
}

/*
 *  Road classes
 */
 
/* main public roads */

way[highway=motorway],     way[highway=motorway_link], 
way[highway=trunk],        way[highway=trunk_link], 
way[highway=primary],      way[highway=primary_link], 
way[highway=secondary],    way[highway=secondary_link], 
way[highway=tertiary],     way[highway=tertiary_link], 
way[highway=unclassified], 
way[highway=residential],  way[highway=living_street] {
  set .carway;
} 

/* underground (tunnels, indoor, in underground buildings) */
*[location=underground],
*[tunnel][tunnel!=no],
*[level<0] {
    set .underground;
}

/* oneway */
way[oneway=yes],
way[oneway=1],
way[oneway=-1]
way[highway=motorway_link][oneway!=no], 
way[highway=trunk_link][oneway!=no], 
way[highway=primary_link][oneway!=no], 
way[highway=secondary_link][oneway!=no], 
way[highway=tertiary_link][oneway!=no] 
{
    set .oneway;
}

/* unpaved roads */
way[surface=unpaved],
way[surface=dirt],
way[surface=ground],
way[surface=sand],
way[surface=grass]
{
  set .unpaved;
}


/*
 * TODO: add some rendering for this types of roads
 */

way[highway=raceway],
way[highway=bridleway],
way[highway=road],
way[highway=proposed],
way[highway=construction] {
    /* None: this is not real exclusion. */
}


/*
 * Road Rendering Strategy (Layering)
 *
 * We use JOSM's support for multiple pseudo-elements (e.g., ::edge, ::fill)
 * to stack several styles on top of each other for each road.
 *
 * The layers are drawn in order of their z-index:
 *
 * z-index: 3  |   <-- Centerline (dashed or double solid)
 * z-index: 2  |   <-- Edge Lines (wide white)
 * z-index: 1  |   <-- Asphalt Fill (dark grey)
 *
 * This creates the effect of white edges and a centerline on a grey road.
 */

/* --- Layer 2: Edge Lines (Bottom Layer) --- */
/* A single, wide white line is drawn first to create the outer edges. */
way|z14[is_prop_set("carway", "default")][!is_prop_set("underground", "default")][!is_prop_set("unpaved", "default")][!area]::edge  { width: 5; color: white; z-index: 1; }
way|z15[is_prop_set("carway", "default")][!is_prop_set("underground", "default")][!is_prop_set("unpaved", "default")][!area]::edge  { width: 8; color: white; z-index: 1; }
way|z16-[is_prop_set("carway", "default")][!is_prop_set("underground", "default")][!is_prop_set("unpaved", "default")][!area]::edge { width: 11; color: white; z-index: 1; }
 
 
 /* --- Layer 1: Asphalt Fill (Middle Layer) --- */
/* A slightly narrower dark grey line is drawn on top of the edges. */
/* main public roads */
way|z14[is_prop_set("carway", "default")][!is_prop_set("underground", "default")][!is_prop_set("unpaved", "default")][!area]::fill  {
    width: 4; color: #444444; z-index: 2;      linecap: rectangular;
}

way|z15[is_prop_set("carway", "default")][!is_prop_set("underground", "default")][!is_prop_set("unpaved", "default")][!area]::fill  {
    width: 7; color: #444444; z-index: 2;     linecap: rectangular;
}
way|z16-[is_prop_set("carway", "default")][!is_prop_set("underground", "default")][!is_prop_set("unpaved", "default")][!area]::fill {
    width: 10; color: #444444; z-index: 2;     linecap: rectangular;
}


/* --- Layer 3: Centerlines (Top Layer, from z15+) --- */

/**
 * Style for One-Way Roads
 *
 * This applies to:
 * - highway=motorway (and links)
 * - junction=roundabout
 * - any road with oneway=yes, oneway=1, or oneway=-1
 *
 * A single dashed white line is drawn in the center.
 */

way|z15-[is_prop_set("carway", "default")][is_prop_set("oneway", "default")][!is_prop_set("underground", "default")][!is_prop_set("unpaved", "default")][!area][lane_markings!=no]::centerline 
{
    width: 0.7;
    color: white;
    dashes: 6, 8;
    z-index: 3;
}


/**
 * Style for Two-Way Roads
 *
 * This applies to:
 * - any road with oneway=no
 * - any road with no 'oneway' tag (and is not implicitly one-way)
 *
 * A double solid white line is faked by drawing two solid lines
 * with a small 'offset' from the center.
 */
way|z15-[is_prop_set("carway", "default")][!is_prop_set("oneway", "default")][!is_prop_set("unpaved", "default")][!area][lane_markings!=no]::centerline_left{
    width: 0.5;
    color: white;
    offset: -0.7;
    z-index: 3;
}
way|z15-[is_prop_set("carway", "default")][!is_prop_set("oneway", "default")][!is_prop_set("unpaved", "default")][!area][lane_markings!=no]::centerline_right {
    width: 0.5;
    color: white;
    offset: 0.7;
    z-index: 3;
}

/* 
 * service roads
 * Luckily, service roads does not not have any markings
 */
way|z14[highway=service][!is_prop_set("underground", "default")][!area]::fill  {
    width: 2;
	color: #444444;
	linecap: rectangular;
	z-index: 2; 
}

way|z15[highway=service][!is_prop_set("underground", "default")][!area]::fill  {
    width: 3;
	color: #444444;
	z-index: 2;
	linecap: none;
}

way|z16-[highway=service][!is_prop_set("underground", "default")][!area]::fill {
    width: 5;
	color: #444444;
	z-index: 2;
	linecap: none;
}

/* 
 * unpaved roads 
 */
/* transit roads*/ 
way|z14[is_prop_set("carway", "default")][is_prop_set("unpaved", "default")][!is_prop_set("underground", "default")][!area]::fill  {
    width: 4; color: #9d6c6c; z-index: 2;      linecap: rectangular;
}
way|z15[is_prop_set("carway", "default")][is_prop_set("unpaved", "default")][!is_prop_set("underground", "default")][!area]::fill  {
    width: 7; color: #9d6c6c; z-index: 2;     linecap: rectangular;
}
way|z16-[is_prop_set("carway", "default")][is_prop_set("unpaved", "default")][!is_prop_set("underground", "default")][!area]::fill {
    width: 10; color: #9d6c6c; z-index: 2;     linecap: rectangular;
}

/* service roads*/ 
way|z14[highway=service][is_prop_set("unpaved", "default")][!is_prop_set("underground", "default")][!area]::fill  {
    width: 2;
	color: #9d6c6c;
	linecap: rectangular;
	z-index: 2; 
}

way|z15[highway=service][is_prop_set("unpaved", "default")][!is_prop_set("underground", "default")][!area]::fill  {
    width: 3;
	color: #9d6c6c;
	z-index: 2;
	linecap: none;
}

way|z16-[highway=service][is_prop_set("unpaved", "default")][!is_prop_set("underground", "default")][!area]::fill {
    width: 5;
	color: #9d6c6c;
	z-index: 2;
	linecap: none;
}


/* highway=track */

way|z15-[highway=track][!area]::left_wheel{
    width: 0.5;
    color: gray;
    offset: -1.5;
	dashes: 2,3;
    z-index: 3;
}
way|z15-[highway=track][!area]::right_wheel {
    width: 0.5;
    color: gray;
    offset: 1.5;
	dashes: 2,3;
    z-index: 3;
}

/* Footways and other non-car roads*/

way|z14-[highway=pedestrian][!is_prop_set("underground", "default")]::fill {
    color: #706060;  
	width: 6;
}

way|z14-[highway=footway][!is_prop_set("underground", "default")]::fill,
way|z14-[highway=path][!is_prop_set("underground", "default")]::fill,
way|z14-[highway=cycleway][!is_prop_set("underground", "default")]::fill {
    color: salmon; 
    dashes: 1,3;
    linecap: none;
    linejoin: round;
    width: 2;
    z-index: 4;
}

way|z15-[highway=steps][!is_prop_set("underground", "default")]::fill {
    color: salmon;
    dashes: 2,1;
    width: 5;
}
